# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env no GitHub — ele esta no .gitignore.
#
# Como usar:
#   cp .env.example .env
#   (edite o .env com seus valores)

# ── Google Cloud Platform ─────────────────────────────────────────────────────
GCP_PROJECT=gpc_project
GCP_REGION=us-central1
BQ_LOCATION=US

# Caminho para a chave JSON da Service Account
# Gere em: GCP Console > IAM > Service Accounts > Create Key
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp_sa_key.json

# ── Kaggle API ────────────────────────────────────────────────────────────────
# Obtenha em: kaggle.com/settings > API > Create New Token
KAGGLE_USERNAME=seu_usuario_kaggle
KAGGLE_KEY=sua_chave_kaggle

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_BUCKET=gpc_project-airflow-dags
FRAUD_DATASET=ulb

# ── Projeto ───────────────────────────────────────────────────────────────────
ENV=development
